# Build output directory (generated by build.bat / CMake)
build/

# CMake user-specific files
CMakeUserPresets.json

# Compiled object files and binaries outside the build directory
*.obj
*.exe
*.pdb
*.ilk
*.lib

# Editor / IDE files
.vs/
.vscode/
*.user

# Python bytecode cache (utils helper scripts)
__pycache__/
*.pyc

# ZCode workspace metadata
.zcode/

# WorkBuddy workspace metadata and project memory
.workbuddy/
